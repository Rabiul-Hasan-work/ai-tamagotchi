{
  "name": "ai-tamagotchi",
  "version": "0.1.0",
  "private": true,
  "description": "Terminal AI Tamagotchi Assistant state engine scaffold",
  "type": "module",
  "bin": {
    "tama": "./dist/index.js"
  },
  "scripts": {
